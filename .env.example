# Supabase project URL — Settings > API in the Supabase dashboard.
# Safe to expose to the browser (NEXT_PUBLIC_*), but nothing in this app
# actually reads it client-side today — both lead-capture forms call our
# own API routes, which are the only thing that talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only key with full database access, bypassing Row Level Security.
# Used exclusively inside app/api/inner-circle/apply and
# app/api/newsletter/subscribe (see lib/supabase.ts) — never sent to the
# browser. Do not prefix this with NEXT_PUBLIC_ under any circumstances.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the founder-only /sanctum dashboard (see lib/sanctum/auth.ts).
# Server-only — never prefix with NEXT_PUBLIC_. Choose a long, random value.
ADMIN_PASSWORD=

# Resend API key — used only to send a best-effort admin notification email
# when a new Inner Circle application is submitted (see lib/email.ts and
# app/api/inner-circle/apply/route.ts). A failed or missing key never blocks
# an application from being saved; it only skips the notification.
# The "from" address in lib/email.ts must belong to a domain verified in
# your Resend dashboard, or every send will fail (silently, from the
# applicant's perspective — check server logs for "INNER CIRCLE EMAIL ERROR").
RESEND_API_KEY=

# Inbox that receives the "New Inner Circle Application" notification email.
ADMIN_NOTIFICATION_EMAIL=

# OpenAI API key — used by the ES-010 reconciliation worker
# (app/api/internal/embeddings/reconcile) to generate embeddings via
# text-embedding-3-small, and by the ES-012 Advisor endpoint
# (app/api/advisor, see lib/advisor/judgmentProvider.ts and
# lib/advisor/generationProvider.ts) for gpt-5.6-luna semantic judgments
# and gpt-5.6-terra generation. Same OpenAI account/key serves all three;
# no separate key is introduced for Advisor. Server-only — never prefix
# with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Shared secret verifying that requests to the ES-010 reconciliation
# endpoint actually come from Vercel Cron (see vercel.json), not an
# arbitrary caller — that endpoint calls a paid third-party API and
# writes to production. Vercel automatically sends this as
# "Authorization: Bearer <CRON_SECRET>" when invoking a scheduled Cron
# Job. Server-only — never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# PA-01 WU-03 opaque admin sessions (security branch; not yet wired into login).
# Server-only secret used to fingerprint password-rotation generations.
# Set a unique cryptographically random value of at least 32 characters.
# Changing ADMIN_PASSWORD or this secret invalidates previously issued sessions.
# Do not use NEXT_PUBLIC_ and do not commit actual values.
ADMIN_SESSION_ROTATION_SECRET=

# Redis REST credentials for the WU-02 limiter and WU-03 session registry.
# Use an isolated nonproduction Upstash database for security validation.
# Never expose either variable to browser code.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
